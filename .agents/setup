#!/usr/bin/env bash
set -euo pipefail

JDK_DIR="$HOME/.local/share/inkleaf-jdk"
ANDROID_SDK_ROOT="$HOME/.local/share/android-sdk"
COMMAND_LINE_TOOLS_VERSION="22.0"

if [[ ! -x "$JDK_DIR/bin/java" ]]; then
    archive="$(mktemp)"
    curl -fsSL -o "$archive" \
        "https://api.adoptium.net/v3/binary/latest/17/ga/linux/x64/jdk/hotspot/normal/eclipse"
    mkdir -p "$JDK_DIR"
    tar -xzf "$archive" -C "$JDK_DIR" --strip-components=1
    rm -f "$archive"
fi

mkdir -p "$HOME/.local/bin"
ln -sf "$JDK_DIR/bin/java" "$HOME/.local/bin/java"
ln -sf "$JDK_DIR/bin/javac" "$HOME/.local/bin/javac"

if ! grep -q "Pkg.Revision=${COMMAND_LINE_TOOLS_VERSION}" \
    "$ANDROID_SDK_ROOT/cmdline-tools/latest/source.properties" 2>/dev/null; then
    archive="$(mktemp)"
    extract_dir="$(mktemp -d)"
    curl -fsSL -o "$archive" \
        "https://dl.google.com/android/repository/commandlinetools-linux-15859902_latest.zip"
    unzip -q "$archive" -d "$extract_dir"
    rm -rf "$ANDROID_SDK_ROOT/cmdline-tools/latest"
    mkdir -p "$ANDROID_SDK_ROOT/cmdline-tools/latest"
    mv "$extract_dir/cmdline-tools/"* "$ANDROID_SDK_ROOT/cmdline-tools/latest/"
    rm -rf "$archive" "$extract_dir"
fi

export JAVA_HOME="$JDK_DIR"
export ANDROID_HOME="$ANDROID_SDK_ROOT"
export ANDROID_SDK_ROOT
export PATH="$JAVA_HOME/bin:$ANDROID_SDK_ROOT/cmdline-tools/latest/bin:$ANDROID_SDK_ROOT/platform-tools:$PATH"

yes | sdkmanager --licenses >/dev/null || true
sdkmanager \
    "platform-tools" \
    "platforms;android-37.0" \
    "build-tools;36.0.0"

printf 'sdk.dir=%s\n' "$ANDROID_SDK_ROOT" > local.properties
