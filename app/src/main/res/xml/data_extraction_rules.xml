<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Album source images can be large and are intentionally restored from exported CBZ files. -->
        <exclude
            domain="file"
            path="albums/" />
        <!-- Retired enhancement artifacts are removed on cold start and must not be restored. -->
        <exclude
            domain="file"
            path="image_enhancement_models/" />
        <exclude
            domain="file"
            path="ai_enhanced_images/" />
        <!-- TODO: Use <include> and <exclude> to control what is backed up.
        <include .../>
        <exclude .../>
        -->
    </cloud-backup>
    <device-transfer>
        <exclude
            domain="file"
            path="albums/" />
        <exclude
            domain="file"
            path="image_enhancement_models/" />
        <exclude
            domain="file"
            path="ai_enhanced_images/" />
    </device-transfer>
</data-extraction-rules>
