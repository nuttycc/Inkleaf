<?xml version="1.0" encoding="utf-8"?><!--
   Sample backup rules file; uncomment and customize as necessary.
   See https://developer.android.com/guide/topics/data/autobackup
   for details.
   Note: This file is ignored for devices older than API 31
   See https://developer.android.com/about/versions/12/backup-restore
-->
<full-backup-content>
    <!-- Album source images can be large and are intentionally restored from exported CBZ files. -->
    <exclude
        domain="file"
        path="albums/" />
    <!-- Retired enhancement artifacts are removed on cold start and must not be restored. -->
    <exclude
        domain="file"
        path="image_enhancement_models/" />
    <exclude
        domain="file"
        path="ai_enhanced_images/" />
    <!--
   <include domain="sharedpref" path="."/>
   <exclude domain="sharedpref" path="device.xml"/>
-->
</full-backup-content>
